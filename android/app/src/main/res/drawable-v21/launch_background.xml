<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen (API 21+) — background putih di-fix (bukan ikut
     dark mode sistem), karena icon-nya didesain di atas kartu putih;
     kalau ikut dark mode nanti kartu putihnya kelihatan aneh mengambang
     di atas background gelap. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
